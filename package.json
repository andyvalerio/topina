{
  "name": "topina",
  "version": "0.0.1",
  "description": "Live distress monitoring for a cat's outdoor walks",
  "type": "module",
  "private": true,
  "scripts": {
    "probe": "node --env-file=.env probe.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node --env-file-if-exists=.env --test \"tests/e2e/*.test.js\"",
    "position": "node --env-file=.env position.js",
    "listen": "node --env-file=.env listen.js",
    "live": "node --env-file=.env live.js",
    "record": "node --env-file=.env record.js",
    "analyse": "node analyse.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "token": "node --env-file=.env token.js"
  }
}
