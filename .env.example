# Tractive account credentials.
# The API only accepts email + password (grant_type=tractive) — no Google or
# Apple SSO. If the account was created with SSO, use the website's
# forgot-password flow to set a password.
TRACTIVE_EMAIL=you@example.com
TRACTIVE_PASSWORD=your-password

# Identifiers, so we don't spend rate-limited calls rediscovering them and
# don't commit them to a public repo. Run `npm run probe` to find yours.
TRACTIVE_PET_ID=
TRACTIVE_TRACKER_ID=

# Display name for the pet, used in logs and on the dashboard.
PET_NAME=
